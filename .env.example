# Discord-Webhook-URL für Scan-Benachrichtigungen (leer lassen = deaktiviert)
DISCORD_WEBHOOK_URL=

# Pfad im Container, unter dem der FiveM-resources-Ordner gemountet wird
RESOURCES_PATH=/resources

# Verzeichnis für Scan-Historie und optionale eigene blocklist.txt
DATA_DIR=/data

# > 0 aktiviert einen automatischen Scan alle N Minuten (0 = deaktiviert)
SCAN_INTERVAL_MINUTES=0

# Port, auf dem das Dashboard/die API laufen
PORT=8080

# --- Zugriffsschutz ---
# Gesetzt = Dashboard und API verlangen "Authorization: Bearer <token>"
# (das Dashboard fragt das Token beim ersten Aufruf ab). Leer = offen.
AUTH_TOKEN=

# Hinter einem Reverse-Proxy: loopback | 1 | true, damit das Rate-Limit die
# echte Client-IP nutzt statt der Proxy-IP.
TRUST_PROXY=

# --- Grenzen (Defaults sind i. d. R. ausreichend) ---
# Max. Anzahl behaltener Scans im Verlauf (ältere werden rotiert)
MAX_HISTORY=100
# Harte Obergrenze für die Laufzeit eines einzelnen Scans (ms)
SCAN_TIMEOUT_MS=120000
# Mindestabstand zwischen zwei Scan-Anfragen pro Client (ms)
SCAN_MIN_INTERVAL_MS=3000
# ZIP-Upload: max. Einträge, entpackte Gesamtgröße/Einzeldatei (Bytes), max. Ratio
MAX_ZIP_ENTRIES=20000
MAX_ZIP_BYTES=536870912
MAX_ZIP_FILE_BYTES=67108864
MAX_ZIP_RATIO=120
